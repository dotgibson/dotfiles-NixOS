# os/nixos.capabilities — the NixOS capability declaration (Core v5, #663).
#
# THE ONE DECLARATIVE HOST IN THE FLEET (PROVISIONER=declarative). Every other repo
# declares a mutable archive whose install verb changes the running system. NixOS does
# not: `configuration.nix` / `nix/home.nix` are where packages come from, and the verbs
# below are the honest imperative escape hatches beside them, not the normal path.
#
# MEASURED, NOT TRANSCRIBED. Every value here was run on a booted NixOS 25.05 guest in
# core/NON-MUTABLE-HOST-PROPOSAL.md's research phase (§5 R1/R2, dotgibson/dotfiles-core#1004)
# and the inline notes are what the measurement found. That is why this file is wordier
# than its siblings: on this host several of the schema's assumptions are false, and an
# unexplained value would read as a typo.
#
# Read (never sourced) by Core's zsh/02-capabilities.zsh into $_CORE_CAP, and by
# core/maint/dotfiles-maint.sh, which is bash. bootstrap.sh links it to
# $ZDOTDIR/os.capabilities.
#
# core/examples/os.capabilities.example documents every key, including the OPTIONAL ones
# this file deliberately omits — in this schema an omission is a STATEMENT, and four of
# them below are load-bearing.
#
# Validate with:  core/scripts/check-capabilities.sh os/nixos.capabilities
#
# A `#` INSIDE A VALUE IS NOT A COMMENT — the reader keeps it. Notes go above.
#
# Written for a CHANNEL-managed box. A flake-managed one swaps exactly two verbs, noted
# inline at PKG_REFRESH and PKG_UPGRADE.

PROVISIONER=declarative

# ── package-manager verbs (required) ──────────────────────────────────────────
PKG_REFRESH=sudo nix-channel --update
# Rebuilds AND activates: no reboot, no PKG_APPLY. The kernel is the exception (a new
# kernel activates at the next boot), which `nixos-rebuild` itself says. This is why
# PROVISIONER=declarative is NOT a staged host: `up` runs this and returns with the box
# updated, exactly as on a mutable one (measured — /run/booted-system stays
# /run/current-system). (Flakes: `nix flake update` in the config directory, then
# `nixos-rebuild switch --flake .`.)
PKG_UPGRADE=sudo nixos-rebuild switch --upgrade
# Imperative, per-user, and it PERSISTS across `nixos-rebuild switch` — the user profile
# is not the system configuration. It is the documented anti-pattern (the declarative way
# is environment.systemPackages or home.packages), but it is a TRUE verb and the schema
# needs one. The newer `nix profile install nixpkgs#…` cannot take the schema's
# space-separated argument, so it is not the value here. core-doctor's missing-tool hint
# under `declarative` says "add it to home.packages" first and names this second.
#
# os/nixos.zsh deliberately does NOT alias these two: declaring them is honesty, aliasing
# them would be promotion.
PKG_INSTALL=nix-env -i
PKG_REMOVE=nix-env -e
# `nix search` needs the nix-command feature on a box that has not enabled it, so the
# flag is part of the verb rather than a prerequisite the caller has to know about.
PKG_SEARCH=nix --extra-experimental-features nix-command search nixpkgs
# Needs the nix-index database (`nix-index` once, then nix-locate reads it). Same shape
# of caveat as `dnf provides` needing dnf's metadata. nix/home.nix installs nix-index
# for exactly this reason — without it this declaration would be a promise the box
# cannot keep.
PKG_OWNS=nix-locate --top-level

# PKG_COUNT_PENDING — DELIBERATELY ABSENT, and this is the one required key with no
# truthful value on this host. "Packages pending" is not a thing a declarative box
# knows; the nearest question — what would a rebuild change? — is `nixos-rebuild
# dry-build --upgrade`, which needs root's channel (sudo) and lists DERIVATIONS, not
# packages. The validator permits the absence under PROVISIONER=declarative
# (core/scripts/check-capabilities.sh), and `up` reads an absent count verb as the -1
# sentinel that keeps the once-a-day nudge silent. That relaxation is the schema's one
# concession to this family.

# ── scheduler (required) ──────────────────────────────────────────────────────
# Measured: systemd user units work on the guest. The declarative alternative is
# `systemd.user.services` in the configuration; this repo does not ship one, so the
# maint layer installs its timer the same way it does everywhere else.
SCHEDULER=systemd
SCHEDULER_UNIT_DIR=~/.config/systemd/user

# ── the optional keys, and why each is absent ─────────────────────────────────
# No PKG_ASSUME_YES        — nixos-rebuild does not prompt.
# No PKG_UPGRADE_PARTIAL   — a configuration switches as a whole; `up -i` correctly refuses.
# No MAINT_UNATTENDED_UPGRADE
#                          — NixOS has `system.autoUpgrade`, declared in the configuration
#                            (see nix/nixos.nix). Core's maint runner must not run a second
#                            upgrader beside it.
# No PKG_APPLY / PKG_APPLY_PENDING
#                          — nothing stages here. Those keys belong to the atomic and
#                            transactional families, where PKG_UPGRADE returns with the
#                            change waiting for a reboot. `nixos-rebuild switch` activates.
#
# ── the login shell (measured, and why bootstrap.sh prints instead of running chsh) ──
# `chsh -s zsh` TOOK on the guest (users.mutableUsers defaults to true) — but a hand-set
# login shell is a change no `nixos-rebuild switch` reproduces, so it is the wrong tool
# here even where it works. bootstrap.sh sets BOOTSTRAP_LOGIN_SHELL=0 and prints the
# declaration instead:
#     users.users.<name>.shell = pkgs.zsh;
#     programs.zsh.enable = true;
# Both live in nix/nixos.nix, the system-side fragment.
